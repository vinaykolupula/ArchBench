{
  "name": "@archbench/web",
  "version": "0.1.0",
  "description": "Interactive Web Studio and Visual Architecture Canvas for ArchBench",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist-server/server/index.js",
  "exports": {
    ".": "./dist-server/server/index.js"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@archbench/archspec": "workspace:*",
    "@archbench/core": "workspace:*",
    "@archbench/archeval": "workspace:*",
    "@archbench/graph-engine": "workspace:*",
    "@archbench/scenario-engine": "workspace:*",
    "@archbench/report-engine": "workspace:*",
    "@archbench/comparison-engine": "workspace:*",
    "@archbench/learning-mode": "workspace:*",
    "@archbench/synthesis": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
