{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archbench.org/schemas/archspec/v0.1.schema.json",
  "title": "ArchSpec",
  "description": "Architecture Specification Schema v0.1 for ArchBench",
  "type": "object",
  "required": ["archbench", "system", "architecture"],
  "additionalProperties": false,
  "properties": {
    "archbench": {
      "type": "object",
      "required": ["spec_version", "project"],
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "type": "string",
          "enum": ["0.1"]
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9-_]+$"
        },
        "description": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "system": {
      "type": "object",
      "required": ["requirements"],
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "users": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "external_systems": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "category": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "category", "priority", "statement"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "category": {
                "type": "string",
                "enum": [
                  "functional",
                  "availability",
                  "latency",
                  "throughput",
                  "durability",
                  "consistency",
                  "security",
                  "compliance",
                  "cost",
                  "operability",
                  "maintainability",
                  "scalability"
                ]
              },
              "priority": {
                "type": "string",
                "enum": ["must", "should", "could", "wont"]
              },
              "statement": { "type": "string" },
              "target": {
                "type": "object",
                "additionalProperties": true
              },
              "measurement_window": { "type": "string" },
              "verification": { "type": "string" }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "category", "statement"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "category": {
                "type": "string",
                "enum": [
                  "team",
                  "deployment",
                  "budget",
                  "technology",
                  "regulatory",
                  "timeline",
                  "operational"
                ]
              },
              "statement": { "type": "string" }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "statement", "status"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["confirmed", "assumed", "unknown"]
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "impact_if_false": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "validation": { "type": "string" },
              "owner": { "type": "string" }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["alternatives"],
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "components", "connections"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "type", "responsibility"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "type": {
                      "type": "string",
                      "enum": [
                        "application",
                        "service",
                        "module",
                        "api_gateway",
                        "load_balancer",
                        "relational_database",
                        "document_database",
                        "key_value_store",
                        "cache",
                        "message_queue",
                        "event_stream",
                        "background_worker",
                        "object_storage",
                        "search_engine",
                        "identity_provider",
                        "external_provider",
                        "observability"
                      ]
                    },
                    "technology": { "type": "string" },
                    "responsibility": { "type": "string" },
                    "requirements": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "deployment": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "replicas": { "type": "integer", "minimum": 1 },
                        "region": { "type": "string" },
                        "platform": { "type": "string" }
                      }
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "ownership": { "type": "string" },
                        "storage_type": { "type": "string" },
                        "retention": { "type": "string" },
                        "backup_frequency": { "type": "string" }
                      }
                    },
                    "messaging": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "delivery_semantics": {
                          "type": "string",
                          "enum": ["at_least_once", "at_most_once", "effectively_once"]
                        },
                        "overload_policy": { "type": "string" },
                        "retention_period": { "type": "string" }
                      }
                    },
                    "behavior": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "idempotent": { "type": "boolean" },
                        "idempotency_key": { "type": "string" },
                        "retry_policy": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "max_attempts": { "type": "integer", "minimum": 1 },
                            "backoff": {
                              "type": "string",
                              "enum": ["fixed", "exponential", "linear"]
                            },
                            "dead_letter_target": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "connections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "from", "to", "protocol"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "from": { "type": "string" },
                    "to": { "type": "string" },
                    "protocol": {
                      "type": "string",
                      "enum": ["synchronous", "asynchronous"]
                    },
                    "transport": { "type": "string" },
                    "purpose": { "type": "string" },
                    "timeout_ms": { "type": "integer", "minimum": 1 },
                    "retry_policy": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "max_attempts": { "type": "integer", "minimum": 1 },
                        "backoff": {
                          "type": "string",
                          "enum": ["fixed", "exponential", "linear"]
                        }
                      }
                    }
                  }
                }
              },
              "decisions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title", "status", "context", "choice"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "status": {
                      "type": "string",
                      "enum": ["proposed", "accepted", "superseded", "deprecated", "rejected"]
                    },
                    "context": { "type": "string" },
                    "choice": { "type": "string" },
                    "alternatives": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "consequences": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "requirements": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "evolution_triggers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "metric", "threshold", "action"],
                        "additionalProperties": false,
                        "properties": {
                          "id": { "type": "string" },
                          "metric": { "type": "string" },
                          "threshold": { "type": "string" },
                          "condition": { "type": "string" },
                          "action": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              },
              "workload": {
                "type": "object",
                "additionalProperties": true
              },
              "objectives": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  }
}

