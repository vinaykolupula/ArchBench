{
  "name": "archbench-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-Source System Design, Architecture Reasoning, and Evaluation Framework",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vishwa98/ArchBench.git"
  },
  "homepage": "https://github.com/vishwa98/ArchBench#readme",
  "bugs": {
    "url": "https://github.com/vishwa98/ArchBench/issues"
  },
  "keywords": [
    "system-design",
    "software-architecture",
    "architecture-evaluation",
    "fitness-tests",
    "model-context-protocol",
    "mcp",
    "ai-agents",
    "benchmarking",
    "distributed-systems",
    "just-enough-architecture"
  ],
  "author": "ArchBench Contributors",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "cli": "pnpm --filter @archbench/cli run dev",
    "ui": "pnpm --filter @archbench/cli run dev ui",
    "dev:ui": "pnpm --filter @archbench/web run dev",
    "mcp": "pnpm --filter @archbench/mcp-server run dev",
    "benchmark": "tsx scripts/run-benchmarks.ts",
    "benchmark:generate": "tsx scripts/generate-benchmarks.ts",
    "validate:examples": "tsx scripts/validate-examples.ts",
    "release:check": "tsx scripts/release-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "tsx": "^4.19.3",
    "yaml": "^2.7.0"
  }
}
